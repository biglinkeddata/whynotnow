---
// Shared form shell for contact / guest / sponsor pages. Posts to the
// endpoint set in content/site.json (e.g. Formspree). Until one is set,
// the form is disabled with a clearly-marked note and an email fallback.
import { site } from '../lib/content.js';
const { name, submitLabel = 'Send it' } = Astro.props;
const live = Boolean(site.formEndpoint);
---
<form
  class="site-form"
  method="post"
  action={live ? site.formEndpoint : undefined}
  onsubmit={live ? undefined : 'return false'}
>
  <input type="hidden" name="form_name" value={name} />
  <slot />
  <button class="btn btn--magenta" type="submit">{submitLabel}</button>
  {!live && (
    <p class="placeholder-note" style="margin-top:1rem">
      Placeholder — set formEndpoint in content/site.json to make this form live.
      Until then, email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
    </p>
  )}
</form>
