---
import SocialIcons from './SocialIcons.astro';
import EmailCapture from './EmailCapture.astro';
import { site } from '../lib/content.js';
const year = new Date().getFullYear();
---
<footer class="site-footer section--painted-band texture-quiet">
  <div class="wrap">
    <p class="script footer-tag">Real conversations. Bold decisions.</p>
    <div class="footer-grid">
      <div class="footer-capture on-ink">
        <EmailCapture id="footer" heading="Don't miss a chapter." sub="New episodes and honest stories, once a week." />
      </div>
      <nav aria-label="Footer" class="footer-nav">
        <ul role="list">
          <li><a href="/episodes/">Episodes</a></li>
          <li><a href="/guests/">Guests</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/newsletter/">Newsletter</a></li>
          <li><a href="/become-a-guest/">Become a Guest</a></li>
          <li><a href="/sponsor/">Sponsor the Podcast</a></li>
          <li><a href="/press-kit/">Press Kit</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-base">
      <SocialIcons />
      <p>&copy; {year} Why Not Now? &middot; <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: var(--section-pad) 0 2.5rem; }
  .footer-tag { color: var(--magenta); margin-bottom: 1.5rem; }
  .footer-grid { display: grid; gap: 2.5rem; }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.5rem;
  }
  .footer-nav a { text-decoration: none; font-weight: 600; }
  .footer-nav a:hover { color: var(--magenta); text-decoration: underline; }
  .footer-base {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .footer-base p { font-size: 0.9rem; opacity: 0.85; }
  @media (min-width: 800px) {
    .footer-grid { grid-template-columns: 1.3fr 1fr; align-items: start; }
    .footer-base { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
