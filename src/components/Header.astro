---
import SocialIcons from './SocialIcons.astro';
const nav = [
  ['/', 'Home'],
  ['/episodes/', 'Episodes'],
  ['/guests/', 'Guests'],
  ['/about/', 'Our Story'],
  ['/become-a-guest/', 'Be a Guest'],
  ['/sponsor/', 'Sponsor'],
  ['/social/', 'Social'],
  ['/contact/', 'Contact'],
];
const path = Astro.url.pathname;
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo-link" href="/" aria-label="Why Not Now! home">
      {/* Wordmark drawn live in Anton (the logo's typeface) so it stays crisp. */}
      <svg class="logo-mark" viewBox="0 0 530 118" role="img" aria-hidden="true">
        <g font-family="'Anton', 'Arial Narrow', sans-serif" font-size="88" fill="#F0EFE9" stroke="#111111" stroke-width="13" paint-order="stroke" stroke-linejoin="round">
          <text x="6" y="94">WHY</text>
          <text x="168" y="94">NOT</text>
          <text x="305" y="94">NOW</text>
        </g>
        <g stroke="#111111" stroke-width="9" stroke-linejoin="round" fill="#E42418" transform="rotate(7 476 60)">
          <path d="M 468 10 L 498 6 L 486 70 L 472 69 Z" />
          <circle cx="482" cy="96" r="13" />
        </g>
      </svg>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {nav.map(([href, label]) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
        <li class="nav-cta"><a class="btn btn--red" href="/newsletter/">Join us</a></li>
        <li class="nav-social"><SocialIcons size={20} /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Transparent header floating over the painted hero, no white strip. */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    color: var(--ink);
    z-index: 20;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .logo-link { display: block; flex-shrink: 0; }
  .logo-mark { width: clamp(170px, 34vw, 240px); height: auto; display: block; }

  .nav-toggle {
    display: grid;
    place-items: center;
    background: var(--yellow); /* solid chip so it reads on any paint behind it */
    border: 3px solid var(--ink);
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    color: var(--ink);
  }
  .burger { display: grid; gap: 5px; }
  .burger i { display: block; width: 22px; height: 3px; background: currentColor; }
  .nav-toggle[aria-expanded="true"] .burger i:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .burger i:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .burger i:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .site-nav { display: none; }
  .site-nav.open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--paper);
    border-top: 3px solid var(--magenta);
    border-bottom: 3px solid var(--ink);
    padding: 1rem var(--space) 2rem;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .site-nav a:not(.btn) {
    display: block;
    padding: 0.65rem 0.25rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .site-nav a:not(.btn):hover { color: var(--magenta); }
  .site-nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--magenta);
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }
  .nav-cta { margin-top: 0.75rem; }
  .nav-social { margin-top: 1rem; }

  @media (min-width: 980px) {
    .nav-toggle { display: none; }
    .site-nav { display: block; }
    .site-nav ul { flex-direction: row; align-items: center; gap: 0.1rem; }
    .site-nav a:not(.btn) { font-size: 0.9rem; padding: 0.5rem 0.45rem; white-space: nowrap; }
    .nav-cta { margin: 0 0 0 0.4rem; }
    .nav-cta .btn { padding: 0.55em 1em; font-size: 0.85rem; white-space: nowrap; }
    .nav-social { display: none; } /* icons live in the footer on desktop */
    .logo-mark { width: clamp(160px, 18vw, 210px); }
  }
  @media (min-width: 1240px) {
    .site-nav ul { gap: 0.25rem; }
    .site-nav a:not(.btn) { font-size: 0.98rem; padding: 0.5rem 0.7rem; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
