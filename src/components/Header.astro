---
import SocialIcons from './SocialIcons.astro';
const nav = [
  ['/episodes/', 'Episodes'],
  ['/guests/', 'Guests'],
  ['/about/', 'About'],
  ['/become-a-guest/', 'Be a Guest'],
  ['/sponsor/', 'Sponsor'],
  ['/contact/', 'Contact'],
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo-link" href="/">
      <img src="/images/logo.svg" alt="Why Not Now? — home" width="220" height="47" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {nav.map(([href, label]) => (
          <li>
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
        <li class="nav-cta"><a class="btn btn--magenta" href="/newsletter/">Join us</a></li>
        <li class="nav-social"><SocialIcons size={20} /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ink);
    color: var(--paper);
    position: relative;
    z-index: 20;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .logo-link { display: block; flex-shrink: 0; }
  .logo-link img { width: clamp(150px, 30vw, 220px); height: auto; }

  .nav-toggle {
    display: grid;
    place-items: center;
    background: none;
    border: 3px solid var(--paper);
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    color: var(--paper);
  }
  .burger { display: grid; gap: 5px; }
  .burger i { display: block; width: 22px; height: 3px; background: currentColor; }
  .nav-toggle[aria-expanded="true"] .burger i:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .burger i:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .burger i:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .site-nav { display: none; }
  .site-nav.open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--ink);
    border-top: 3px solid var(--magenta);
    padding: 1rem var(--space) 2rem;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .site-nav a:not(.btn) {
    display: block;
    padding: 0.65rem 0.25rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .site-nav a:not(.btn):hover { color: var(--yellow); }
  .site-nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--magenta);
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }
  .nav-cta { margin-top: 0.75rem; }
  .nav-social { margin-top: 1rem; }

  @media (min-width: 980px) {
    .nav-toggle { display: none; }
    .site-nav { display: block; }
    .site-nav ul { flex-direction: row; align-items: center; gap: 0.25rem; }
    .site-nav a:not(.btn) { font-size: 0.98rem; padding: 0.5rem 0.7rem; }
    .nav-cta { margin: 0 0 0 0.5rem; }
    .nav-cta .btn { padding: 0.55em 1.1em; font-size: 0.85rem; }
    .nav-social { display: none; } /* icons live in the footer on desktop */
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
