---
import Base from '../layouts/Base.astro';
---
<Base title="Got it | Why Not Now?" description="Your message is in. We read everything. Promise.">
  <section class="section section--painted" style="min-height:60vh; display:grid; align-items:center">
    <div class="wrap center">
      <h1 class="display display--hero outlined">Got it.</h1>
      <p class="chip-line" style="margin-bottom:1.5rem"><span class="script paint-chip">We read everything. Promise.</span></p>
      <a class="btn btn--red" href="/">Back to the show</a>
    </div>
  </section>
</Base>
