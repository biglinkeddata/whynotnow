---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
---
<Base
  title="Newsletter — Why Not Now?"
  description="One email a week from Emma and Chloe — new episodes, honest stories and one nudge towards your next chapter."
>
  <section class="section section--painted newsletter-hero">
    <div class="wrap">
      <p class="pill">The newsletter</p>
      <h1 class="display display--hero outlined">In your corner,<br />in your inbox</h1>
      <p class="script" style="color:var(--magenta); margin-top:1.25rem">One a week. Worth opening.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap wrap--narrow">
      <h2 class="display display--lg">What you'll get</h2>
      <ul class="starlist">
        <li>The new episode, first — with the bit you shouldn't skip.</li>
        <li>One honest story of reinvention from a listener or guest.</li>
        <li>One small nudge for your own next chapter. No homework, no hustle.</li>
        <li>First dibs on live events and everything else we're building.</li>
      </ul>
      <p>No spam. No selling your data. Unsubscribe any time, no hard feelings.</p>
      <div style="margin-top:2rem"><EmailCapture id="newsletter" heading="Get on the list" sub="Join before episode one and you're a founding listener. That matters to us." /></div>
    </div>
  </section>
</Base>
