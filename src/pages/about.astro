---
import Base from '../layouts/Base.astro';
import QuoteGrid from '../components/QuoteGrid.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { hosts, site } from '../lib/content.js';
---
<Base
  title="Our Story | Why Not Now?"
  description="Chloe Everton and Emma Elston MBE have been friends for over 40 years. Why Not Now? is what happened when they stopped waiting: more than a podcast, the start of a movement."
>
  <section class="section section--painted">
    <div class="wrap">
      <p class="pill">Our story</p>
      <h1 class="display display--hero outlined">Not a podcast.<br />A movement.</h1>
      <p class="script paint-chip" style="margin-top:1.5rem">Well, also a podcast. A really good one.</p>
    </div>
  </section>

  <section class="section section--paper fade-in">
    <div class="wrap wrap--narrow">
      <h2 class="display display--lg">Friends for over <span class="swash">40 years</span></h2>
      <p><strong>Chloe Everton</strong> and <strong>Emma Elston MBE</strong> have been
      friends for over 40 years.</p>
      <p>We've celebrated the highs, supported each other through the lows and laughed
      through just about everything in between.</p>
      <p>Somewhere along the way we realised something...</p>
      <p>Every life-changing decision starts with one simple question:
      <strong>why not now?</strong></p>
    </div>
  </section>

  <section class="section section--yellow fade-in">
    <div class="wrap">
      <p class="pill pill--tilt-r">Your hosts</p>
      <h2 class="display display--lg" style="margin:0.75rem 0 1.75rem">Two friends, one question</h2>
      <div class="about-hosts">
        {hosts.map((h) => {
          const Bio = h.Content;
          return (
            <article class="about-host">
              <img src={h.photo} alt={`Photo of ${h.name}`} width="600" height="720" loading="lazy" />
              <div>
                <h3 class="display display--md">{h.name}</h3>
                <div class="about-host-bio"><Bio /></div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--paper fade-in">
    <div class="wrap">
      <p class="pill">The manifesto</p>
      <QuoteGrid />
    </div>
  </section>

  <section class="section section--blue fade-in">
    <div class="wrap wrap--narrow">
      <h2 class="display display--lg">Where this is going</h2>
      <p class="measure">The podcast is just the beginning. We're building something
      bigger: live events, a community that champions bold decisions, and partnerships
      with brands that believe in reinvention. If you've ever thought,
      <em>"maybe one day,"</em> we're here to ask a different question:
      <strong>why not now?</strong> If you want in early:</p>
      <div style="margin-top:1.5rem"><EmailCapture id="about" compact /></div>
      <p style="margin-top:2rem">
        Want to be part of it another way?
        <a href="/become-a-guest/" style="color:var(--yellow); font-weight:700">Share your story</a> or
        <a href="/sponsor/" style="color:var(--yellow); font-weight:700">back the bold</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .about-hosts { display: grid; gap: 2.5rem; }
  .about-host { display: grid; gap: 1.5rem; }
  .about-host img { border: 4px solid var(--ink); width: 100%; max-width: 24rem; }
  .about-host h3 { margin: 0 0 0.75rem; }
  .about-host-bio { font-size: 1rem; }
  @media (min-width: 800px) {
    .about-host { grid-template-columns: minmax(0, 20rem) 1fr; align-items: start; }
  }
</style>
