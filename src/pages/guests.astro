---
import Base from '../layouts/Base.astro';
import GuestCard from '../components/GuestCard.astro';
import { guests } from '../lib/content.js';
---
<Base
  title="Guests | Why Not Now?"
  description="The women (and a few men) who tore up the script and started again: every guest who has joined Chloe and Emma on Why Not Now?"
>
  <section class="section section--painted-band">
    <div class="wrap">
      <p class="pill">Guests</p>
      <h1 class="display display--xl outlined">The ones who jumped</h1>
      <p class="chip-line" style="max-width:34ch">
        <span class="script paint-chip">Every guest on this show decided the life they had
        wasn't the life they wanted, and did something about it.</span>
      </p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      {guests.length > 0 ? (
        <div class="cardgrid cardgrid--3">
          {guests.map((g) => <GuestCard guest={g} />)}
        </div>
      ) : (
        <div class="wrap--narrow">
          <h2 class="display display--lg">First guests announcing soon</h2>
          <p class="measure">We're recording now. The roster lands here the moment
          episode one does. Join the newsletter and meet them first.</p>
          <p style="margin-top:1.5rem"><a class="btn btn--red" href="/newsletter/">Keep me posted</a></p>
        </div>
      )}
    </div>
  </section>

  <section class="section section--blue">
    <div class="wrap guest-cta">
      <div>
        <h2 class="display display--lg">Got a "why not now" story?</h2>
        <p class="measure">If you've reinvented your business, career, health or life,
        or you're mid-leap right now, we want to hear it.</p>
      </div>
      <a class="btn btn--red" href="/become-a-guest/">Share your story</a>
    </div>
  </section>
</Base>

<style>
  .guest-cta { display: grid; gap: 1.5rem; align-items: center; }
  .guest-cta h2 { margin-bottom: 0.5em; }
  @media (min-width: 900px) { .guest-cta { grid-template-columns: 1fr auto; } }
</style>
