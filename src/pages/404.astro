---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Why Not Now?" description="That page has reinvented itself as a 404.">
  <section class="section section--painted" style="min-height:60vh; display:grid; align-items:center">
    <div class="wrap center">
      <h1 class="display display--hero outlined">Well.<br />That's gone.</h1>
      <p class="script" style="color:var(--magenta); margin:1.5rem 0">Even pages reinvent themselves around here.</p>
      <a class="btn btn--red" href="/">Start again — why not now?</a>
    </div>
  </section>
</Base>
